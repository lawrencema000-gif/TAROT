# Netlify _headers fallback. netlify.toml already declares these under the
# [[headers]] block, but some Netlify deploys fail to apply TOML rules (same
# pattern the existing _redirects file comments on). This file is the
# belt-and-suspenders source of truth served straight from `dist/_headers`.
#
# Keep the two in sync. If you change a header, update BOTH netlify.toml
# and this file.

/version.json
  Cache-Control: no-store

# index.html — short cache so deploys reach users fast. The hashed JS/CSS
# chunks referenced inside it ARE long-cached (immutable filenames), so
# revalidating the entry point is enough to flip every user to the new
# bundle on next page load. Without this, returning users see stale JS
# until their browser cache or service worker expires.
/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Long-cache hashed assets — filenames change on every build so it's safe.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-XSS-Protection: 1; mode=block
# NOTE: this CSP is duplicated in netlify.toml. Netlify applies the toml
# headers as well as this file, and a difference between them is invisible
# until something is blocked in production. Change both, together.
#
# Two gaps found live on 2026-09-01, both silent (a CSP block is a console
# message, not an error anyone sees):
#   - `https://*.analytics.google.com` does NOT match the bare host
#     `analytics.google.com`. A CSP wildcard requires at least one label, and
#     GA4 posts to the bare host, so those hits were dropped.
#   - `googleads.g.doubleclick.net` was in img-src, connect-src and frame-src
#     but not script-src, so the Google Ads CONVERSION TRACKING script never
#     loaded — paid acquisition was unmeasurable.
#
# The `www.google.<ccTLD>` list under img-src is the Ads remarketing pixel,
# which hits the visitor's own country domain. That list is structurally
# incomplete — it can never cover every country — and a miss costs a
# remarketing audience entry, not a conversion. Extend it for the markets
# that actually matter to the business.
